# Local development defaults. Bind the database to localhost only.
POSTGRES_PASSWORD=lenny_local_dev_only
DATABASE_URL=postgresql+asyncpg://lenny_app:lenny_local_dev_only@127.0.0.1:5433/lenny_assistant
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local model demo (no cloud key required)
LLM_PROVIDER=ollama
ENABLE_PI_PROVIDER=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
RETRIEVAL_MIN_SIMILARITY=0.35

# Optional cloud providers; leave blank for local-only usage.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Set VITE_API_BASE_URL only for a separately hosted backend.
VITE_API_BASE_URL=
